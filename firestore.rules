rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'mubasshirqayyum2@gmail.com')
      );
    }

    // 1. Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 2. Guests Collection (Private - strictly protected from public scraping)
    match /guests/{guestId} {
      allow read, write: if isAdmin();
    }

    // 3. Invitations Collection (Tokenized lookup: individual get by token ID allowed, no public list)
    match /invitations/{invitationId} {
      allow get: if isValidId(invitationId);
      allow list, write: if isAdmin();
    }

    // 4. RSVPs Collection (Guests create and update their own RSVP; Admin has full overview)
    match /rsvps/{rsvpId} {
      allow get: if isValidId(rsvpId);
      allow list: if isAdmin();
      allow create: if isValidId(rsvpId) && incoming().guestId is string && incoming().status in ['attending', 'declined', 'pending'];
      allow update: if isValidId(rsvpId) && incoming().guestId is string && (isAdmin() || incoming().guestId == existing().guestId);
      allow delete: if isAdmin();
    }

    // 5. Events Collection (Public read for wedding details; write by Admin)
    match /events/{eventId} {
      allow read: if isValidId(eventId);
      allow write: if isAdmin();
    }

    // 6. Gallery Collection (Public read for wedding memories; write by Admin)
    match /gallery/{galleryId} {
      allow read: if isValidId(galleryId);
      allow write: if isAdmin();
    }

    // 7. Website Settings (Public read for announcement & memories state; write by Admin)
    match /websiteSettings/{settingId} {
      allow read: if isValidId(settingId);
      allow write: if isAdmin();
    }
  }
}
