{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Administrator account with verified role-based access",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["admin"] },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "Guest": {
      "title": "Guest",
      "description": "Private guest profile with contact details and seat allocation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "familyGroup": { "type": "string", "maxLength": 100 },
        "invitationToken": { "type": "string", "maxLength": 64 },
        "maxGuests": { "type": "number" },
        "phone": { "type": "string", "maxLength": 30 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "invitationToken", "maxGuests"]
    },
    "Invitation": {
      "title": "Invitation",
      "description": "Tokenized invitation card accessed securely by the invited guest",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "guestId": { "type": "string", "maxLength": 128 },
        "guestName": { "type": "string", "maxLength": 100 },
        "familyGroup": { "type": "string", "maxLength": 100 },
        "token": { "type": "string", "maxLength": 64 },
        "maxGuests": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["guestId", "guestName", "token", "maxGuests"]
    },
    "Rsvp": {
      "title": "Rsvp",
      "description": "RSVP submission recorded by the guest",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "guestId": { "type": "string", "maxLength": 128 },
        "invitationToken": { "type": "string", "maxLength": 64 },
        "guestName": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["attending", "declined", "pending"] },
        "attendeesCount": { "type": "number" },
        "dietaryOrNotes": { "type": "string", "maxLength": 500 },
        "submittedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["guestId", "invitationToken", "status", "attendeesCount"]
    },
    "Event": {
      "title": "Event",
      "description": "Wedding ceremony details for the Walima",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 100 },
        "eventType": { "type": "string", "maxLength": 50 },
        "date": { "type": "string", "maxLength": 50 },
        "time": { "type": "string", "maxLength": 50 },
        "timezone": { "type": "string", "maxLength": 50 },
        "venue": { "type": "string", "maxLength": 120 },
        "address": { "type": "string", "maxLength": 200 },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "eventType", "date", "venue"]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "Curated photograph or highlight film entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 120 },
        "category": { "type": "string", "maxLength": 50 },
        "mediaUrl": { "type": "string", "maxLength": 500 },
        "caption": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "category"]
    },
    "WebsiteSetting": {
      "title": "WebsiteSetting",
      "description": "Global website configuration, memories status, and announcements",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "eventTitle": { "type": "string", "maxLength": 120 },
        "memoriesActivated": { "type": "boolean" },
        "announcement": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string" }
      },
      "required": ["memoriesActivated"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "Admin" },
      "description": "Administrator roles and verified credentials"
    },
    "/guests/{guestId}": {
      "schema": { "$ref": "Guest" },
      "description": "Private guest database records managed exclusively by the administrator"
    },
    "/invitations/{invitationId}": {
      "schema": { "$ref": "Invitation" },
      "description": "Tokenized invitation documents looked up securely by individual invitation link"
    },
    "/rsvps/{rsvpId}": {
      "schema": { "$ref": "Rsvp" },
      "description": "RSVP submissions submitted and updated by invited guests"
    },
    "/events/{eventId}": {
      "schema": { "$ref": "Event" },
      "description": "Walima event details, venue address, and ceremony schedule"
    },
    "/gallery/{galleryId}": {
      "schema": { "$ref": "GalleryItem" },
      "description": "Curated photography and cinematic video entries"
    },
    "/websiteSettings/{settingId}": {
      "schema": { "$ref": "WebsiteSetting" },
      "description": "Global website settings and memories activation state"
    }
  }
}
